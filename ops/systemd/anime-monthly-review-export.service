[Unit]
Description=Export verified Pi cross-source subtitle work IDs (no private paths) for month-end GitHub DB release
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/anime-db-download
EnvironmentFile=/home/pi/.config/streaming-project/anime-db.env
UMask=0077
ExecStart=/usr/bin/python3 /home/pi/anime-db-download/scripts/pi_export_reviewed_work_groups.py
