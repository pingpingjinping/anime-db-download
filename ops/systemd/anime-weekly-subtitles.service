[Unit]
Description=Download weekly subtitle queues on the Pi
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/anime-db-download
EnvironmentFile=/home/pi/.config/streaming-project/anime-db.env
UMask=0077
ExecStart=/usr/bin/bash /home/pi/anime-db-download/scripts/pi_weekly_subtitle_sync.sh
