[Unit]
Description=Upload previously verified first-day Pi cross-source ID snapshot to GitHub release
Wants=network-online.target
After=network-online.target anime-monthly-review-export.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/anime-db-download
EnvironmentFile=/home/pi/.config/streaming-project/anime-db.env
UMask=0077
ExecStart=/usr/bin/python3 /home/pi/anime-db-download/scripts/pi_export_reviewed_work_groups.py --publish-staged
